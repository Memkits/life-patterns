{
  "dependencies": {
    "@calcit/procs": "0.27.0",
    "copy-text-to-clipboard": "^3.2.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "vite": "8.3.1"
  },
  "scripts": {
    "compile": "calcit calcit.cirru js",
    "build": "yarn compile && vite build",
